# ---------------------------------------------------------------------------
# FA-MAS configuration. Copy to .env and adjust. Everything has a safe default:
# with no configuration the system runs fully offline on the deterministic mock LLM.
# ---------------------------------------------------------------------------

# LLM provider: mock | openai | anthropic | claude_agent_sdk
#   "openai" works with any OpenAI-compatible endpoint via FAMAS_LLM_BASE_URL
#   (OpenAI, DeepSeek, Qwen/DashScope compatible mode, vLLM, Ollama, ...).
#   "claude_agent_sdk" is EXPERIMENTAL and for personal local testing only: it runs agents
#   through Claude Code with your own Claude login on your own machine (no API key). It is not
#   a public execution mode. See the section at the end of this file and docs/claude-agent-sdk.md.
FAMAS_LLM_PROVIDER=mock
FAMAS_LLM_MODEL=gpt-4o
# Optional cheaper model used by "small"-tier agents (fast research/analysis, judges, analyzers)
FAMAS_LLM_SMALL_MODEL=gpt-4o-mini
# FAMAS_LLM_BASE_URL=https://api.deepseek.com/v1
# FAMAS_LLM_API_KEY=...            # or OPENAI_API_KEY / ANTHROPIC_API_KEY
# FAMAS_STRUCTURED_METHOD=function_calling   # or json_schema / json_mode
# FAMAS_PRICE_IN_PER_1M=2.5        # override token prices for cost accounting
# FAMAS_PRICE_OUT_PER_1M=10

# GitHub API token (raises rate limits for live repository research)
# GITHUB_TOKEN=<your-github-token>

# Persistence: SQLite by default, PostgreSQL supported
FAMAS_DATABASE_URL=sqlite:///./data/famas.db
# FAMAS_DATABASE_URL=postgresql://famas:famas@localhost:5432/famas

# LangGraph checkpointing of workflow state: none | memory
# (any LangGraph checkpointer can also be passed programmatically: Engine(checkpointer=...))
FAMAS_CHECKPOINTER=none

# UI pacing for mock runs (fraction of simulated time actually slept)
FAMAS_UI_TIME_SCALE=0.08

# --- Local API safety (the API has no user accounts; it is meant for this machine) ---
# Browser origins allowed to call the API. "*" is ignored unless FAMAS_LLM_PROVIDER=mock.
FAMAS_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173
# Host headers the API answers to (blocks DNS-rebinding attacks from web pages)
FAMAS_ALLOWED_HOSTS=localhost,127.0.0.1
# Live mode: execute Python written by the model in the code sandbox (no network/file isolation!)
FAMAS_ALLOW_GENERATED_CODE=false

# ---------------------------------------------------------------------------
# Claude Agent SDK provider (FAMAS_LLM_PROVIDER=claude_agent_sdk). EXPERIMENTAL.
# Personal local testing by the account holder only. Never share, host or expose this mode for
# other people; anything offered to others must use API-key auth (FAMAS_LLM_PROVIDER=anthropic).
#   pip install -e ".[claude]"      then sign in once in a terminal:  claude  →  /login
# FA-MAS never reads or stores credentials: Claude Code uses the login you created with
# Anthropic's own flow. Do NOT set ANTHROPIC_API_KEY / ANTHROPIC_AUTH_TOKEN /
# ANTHROPIC_BASE_URL / CLAUDE_CODE_USE_* - the provider refuses to run if they are set,
# because Claude Code would then bill an API key or cloud account instead of your plan.
# Check readiness without any model call:  famas claude doctor --offline-test [--check-login]
# ---------------------------------------------------------------------------
# Safe by default: no model call happens unless you switch this on yourself.
FAMAS_CLAUDE_ALLOW_REAL_CALLS=false
# Offline rehearsal: scripted responses through the real SDK (no process, no network, free).
# Takes precedence over FAMAS_CLAUDE_ALLOW_REAL_CALLS.
FAMAS_CLAUDE_DRY_RUN=false
# Claude Code model aliases or full model ids
FAMAS_CLAUDE_MODEL=sonnet
FAMAS_CLAUDE_SMALL_MODEL=haiku
# Budgets (real calls count against your subscription's shared usage limits)
FAMAS_CLAUDE_MAX_CALLS_PER_RUN=40
FAMAS_CLAUDE_MAX_PARALLEL=2
FAMAS_CLAUDE_MAX_TURNS=3
FAMAS_CLAUDE_TIMEOUT_S=300
# SDK-side cap on the *estimated* API-equivalent cost of one call ("none" to disable)
FAMAS_CLAUDE_MAX_BUDGET_USD_PER_CALL=1.0
# native (SDK structured output) | prompt (JSON requested in the prompt)
FAMAS_CLAUDE_STRUCTURED_OUTPUT=native
# Also stop when Claude reports you are close to a usage limit (always stops when a limit
# is hit or when requests would be served from usage credits, a.k.a. extra usage)
FAMAS_CLAUDE_STOP_ON_LIMIT_WARNING=false
# FAMAS_CLAUDE_CLI_PATH=/path/to/claude   # default: CLI bundled with claude-agent-sdk
# FAMAS_CLAUDE_WORKDIR=./data/claude-workdir
# One metadata line per Claude call (tokens, model, timing, API-equivalent estimate, rate-limit
# status); never prompts, outputs or credentials. "none" disables it.
FAMAS_CLAUDE_USAGE_LOG=./data/claude-usage.jsonl
